# Mausam AI Weather Intelligence Platform Configuration
# None of these keys are strictly required: the app runs with 100% functionality
# using Open-Meteo's free open APIs and an on-device rule-based AI engine.

# Optional: Cloud LLM API Keys for enhanced natural language AI Assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: AI Backend Proxy URL (if delegating requests to a secure server)
# WEATHER_AI_PROXY_URL=https://your-backend-proxy.example.com/api/chat

# Optional: Open-Meteo API Key (Open-Meteo is free without an API key up to 10k calls/day; optional for dedicated customer tier)
OPEN_METEO_API_KEY=

# Optional: TomTom Traffic Flow API Key for live road congestion
TOMTOM_API_KEY=
